{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/m/:code",
      "destination": "/?tag=:code",
      "permanent": false
    },
    {
      "source": "/t/:code",
      "destination": "/?tag=:code",
      "permanent": false
    },
    {
      "source": "/S/:code",
      "destination": "/?tag=:code",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/gestion-chapitas",
      "destination": "/gestion-chapitas.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/gestion-chapitas(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
