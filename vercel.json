{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": "p7.vercel.app",
  "redirects": [
    {
      "source": "/S/:code",
      "destination": "/?tag=:code",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:code([A-Za-z0-9]{3,4})",
      "destination": "/s.html"
    }
  ]
}
