{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "tag",
          "value": "(?<tag>[A-Za-z0-9]+)"
        }
      ],
      "destination": "/tag.html?tag=:tag",
      "permanent": false
    },
    {
      "source": "/m/:code",
      "destination": "/tag.html?tag=:code",
      "permanent": false
    },
    {
      "source": "/t/:code",
      "destination": "/tag.html?tag=:code",
      "permanent": false
    },
    {
      "source": "/S/:code",
      "destination": "/tag.html?tag=:code",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mi-cuenta/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/mi-cuenta/terminos",
      "destination": "/terminos.html"
    },
    {
      "source": "/mi-cuenta/publico",
      "destination": "/index.html"
    },
    {
      "source": "/gestion-chapitas",
      "destination": "/gestion-chapitas.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/gestion-chapitas(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
